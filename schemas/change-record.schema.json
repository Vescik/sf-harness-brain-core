{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sf-harness-brain-core:change-record.schema.json",
  "title": "Governed change work record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordId",
    "recordRevision",
    "createdAt",
    "updatedAt",
    "workItem",
    "state",
    "requestedOutcome",
    "scope",
    "scopeHash",
    "groundingHash",
    "environment",
    "ruleRefs",
    "contextRefs",
    "assumptions",
    "unknowns",
    "blockingQuestions",
    "design",
    "approvals",
    "evidenceRefs",
    "implementation",
    "verification",
    "review",
    "repositories",
    "currentHandoffId",
    "handoffHistoryRefs",
    "events"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "recordId": {
      "type": "string",
      "pattern": "^(ADO-[a-z0-9][a-z0-9-]{0,62}-[1-9][0-9]*|SD-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]{0,40})$"
    },
    "recordRevision": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "workItem": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/workItem"
        }
      ]
    },
    "state": {
      "$ref": "#/$defs/state"
    },
    "requestedOutcome": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "scopeHash": {
      "$ref": "#/$defs/sha256"
    },
    "groundingHash": {
      "$ref": "#/$defs/sha256"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "ruleRefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ruleRef"
      }
    },
    "contextRefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contextRef"
      },
      "uniqueItems": true
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "blockingQuestions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blockingQuestion"
      }
    },
    "design": {
      "$ref": "#/$defs/design"
    },
    "approvals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/approval"
      }
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceRef"
      }
    },
    "implementation": {
      "$ref": "#/$defs/implementation"
    },
    "verification": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/verification"
      }
    },
    "review": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/review"
        }
      ]
    },
    "repositories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/repository"
      }
    },
    "currentHandoffId": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^HO-[A-Za-z0-9][A-Za-z0-9._-]{5,127}$"
        }
      ]
    },
    "handoffHistoryRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^handoffs/[^/]+\\.json$"
      },
      "uniqueItems": true
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "entryRefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entryRef"
      },
      "description": "Optional approved Knowledge Entry grounding (SAFE-CLAIM-001 v2); present only when entries are bound."
    },
    "solutionDesign": {
      "type": "object",
      "description": "Design Case structured state. Validated against schemas/solution-design-state.schema.json by the Solution Design runtime, which is its only authority; the change record deliberately keeps it opaque rather than restating those definitions."
    },
    "featureRefs": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "$ref": "#/$defs/featureRef"
      },
      "description": "Claim-scoped Feature Knowledge citations; verified by knowledge_store.py feature-verify-citations. Optional everywhere entryRefs are optional."
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nullableDateTime": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "role": {
      "enum": [
        "solution-designer",
        "config-investigator",
        "development-assistant",
        "test-strategist",
        "guardrail-reviewer",
        "human",
        "system"
      ]
    },
    "workItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "organization",
        "project",
        "id",
        "type",
        "url",
        "revision",
        "fetchedAt"
      ],
      "properties": {
        "system": {
          "const": "azure-devops"
        },
        "organization": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "project": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "url": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          ]
        },
        "revision": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          ]
        },
        "fetchedAt": {
          "$ref": "#/$defs/nullableDateTime"
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "status"
      ],
      "properties": {
        "phase": {
          "enum": [
            "intake",
            "design",
            "development",
            "qa",
            "review",
            "complete"
          ]
        },
        "status": {
          "enum": [
            "draft",
            "awaiting_human",
            "accepted",
            "in_progress",
            "ready",
            "needs_fixes",
            "incomplete",
            "blocked",
            "safe",
            "stopped",
            "complete"
          ]
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceRoot",
        "components",
        "paths"
      ],
      "properties": {
        "workspaceRoot": {
          "const": "brain-core"
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          },
          "uniqueItems": true
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "uniqueItems": true
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "ruleRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "tier",
        "sourceFile",
        "sourceSha256"
      ],
      "properties": {
        "ruleId": {
          "type": "string",
          "pattern": "^(SAFE|MP|ORG|SF)-[A-Z0-9-]+$"
        },
        "tier": {
          "enum": [
            "kernel",
            "1",
            "2",
            "3"
          ]
        },
        "sourceFile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sourceSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "alias",
        "isSandbox",
        "nonProduction",
        "verificationRef",
        "verifiedAt"
      ],
      "properties": {
        "status": {
          "enum": [
            "unverified",
            "verified"
          ]
        },
        "alias": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "isSandbox": {
          "description": "Salesforce's Organization.IsSandbox, mirrored from the receipt. Descriptive only — legitimately false for a Developer Edition.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "nonProduction": {
          "description": "The security verdict mirrored from the receipt. This is what a verified environment requires; isSandbox is not.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "verificationRef": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        },
        "verifiedAt": {
          "$ref": "#/$defs/nullableDateTime"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unverified"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "isSandbox": {
                "type": "null"
              },
              "nonProduction": {
                "type": "null"
              },
              "verificationRef": {
                "type": "null"
              },
              "verifiedAt": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "verified"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "alias": {
                "type": "string",
                "minLength": 1
              },
              "isSandbox": {
                "type": "boolean"
              },
              "nonProduction": {
                "const": true
              },
              "verificationRef": {
                "type": "string",
                "pattern": "^evidence/EV-[^/]+\\.json$"
              },
              "verifiedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      ]
    },
    "contextRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "policy",
            "knowledge",
            "contract",
            "source",
            "decision"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        }
      }
    },
    "blockingQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "owner",
        "status",
        "resolutionRef"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^BQ-[A-Za-z0-9._-]+$"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "status": {
          "enum": [
            "open",
            "resolved"
          ]
        },
        "resolutionRef": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^design\\.md$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvalId",
        "kind",
        "approver",
        "approvedAt",
        "mechanism",
        "approvalRef",
        "scopeHash",
        "designHash",
        "groundingHash",
        "status",
        "invalidatedAt",
        "invalidationReason"
      ],
      "properties": {
        "approvalId": {
          "type": "string",
          "pattern": "^AP-[A-Za-z0-9._-]+$"
        },
        "kind": {
          "const": "design"
        },
        "approver": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time"
        },
        "mechanism": {
          "enum": [
            "human-terminal",
            "github-review"
          ]
        },
        "approvalRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "scopeHash": {
          "$ref": "#/$defs/sha256"
        },
        "designHash": {
          "$ref": "#/$defs/sha256"
        },
        "groundingHash": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "enum": [
            "active",
            "superseded"
          ]
        },
        "invalidatedAt": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "invalidationReason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "path",
        "sha256",
        "type",
        "completeness",
        "durability",
        "sourceRef",
        "sourceRevision",
        "retrievedAt"
      ],
      "properties": {
        "evidenceId": {
          "type": "string",
          "pattern": "^EV-[A-Za-z0-9._-]+$"
        },
        "path": {
          "type": "string",
          "pattern": "^evidence/[^/]+\\.json$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "completeness": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "durability": {
          "enum": [
            "durable",
            "ephemeral"
          ]
        },
        "sourceRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "sourceRevision": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filesChanged",
        "notes"
      ],
      "properties": {
        "filesChanged": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verificationId",
        "profileId",
        "performedAt",
        "role",
        "status",
        "evidenceRef",
        "receiptSha256",
        "repositoryHeadCommit"
      ],
      "properties": {
        "verificationId": {
          "type": "string",
          "pattern": "^VR-[A-Za-z0-9._-]+$"
        },
        "profileId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$"
        },
        "performedAt": {
          "type": "string",
          "format": "date-time"
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "timed-out",
            "output-limit-exceeded"
          ]
        },
        "evidenceRef": {
          "type": "string",
          "pattern": "^evidence/EV-[^/]+\\.json$"
        },
        "receiptSha256": {
          "$ref": "#/$defs/sha256"
        },
        "repositoryHeadCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewId",
        "reviewedAt",
        "role",
        "verdict",
        "findings"
      ],
      "properties": {
        "reviewId": {
          "type": "string",
          "pattern": "^RV-[A-Za-z0-9._-]+$"
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        },
        "role": {
          "const": "guardrail-reviewer"
        },
        "verdict": {
          "enum": [
            "SAFE",
            "NEEDS_FIXES",
            "INCOMPLETE",
            "STOPPED"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceRoot",
        "remote",
        "branch",
        "baseCommit",
        "headCommit",
        "dirtyPaths",
        "capturedAt"
      ],
      "properties": {
        "workspaceRoot": {
          "const": "brain-core"
        },
        "remote": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "branch": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "baseCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "headCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "dirtyPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "uniqueItems": true
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "at",
        "action",
        "role",
        "fromState",
        "toState",
        "note"
      ],
      "properties": {
        "eventId": {
          "type": "string",
          "pattern": "^ET-[A-Za-z0-9._-]+$"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "fromState": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/state"
            }
          ]
        },
        "toState": {
          "$ref": "#/$defs/state"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "entryRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entryId",
        "reviewedContentDigest",
        "factsDigest",
        "sourceTreeDigest",
        "profile"
      ],
      "properties": {
        "entryId": {
          "type": "string",
          "pattern": "^(?!Feature:)[A-Za-z][A-Za-z0-9]{1,79}:[A-Za-z0-9_]{1,15}:.{1,240}$",
          "description": "Artifact entry identity `<MetadataType>:<ns|c>:<FullName>` (docs/knowledge-one-file-contract.md par 3). The `Feature:` lookahead backstops the three-segment shape explicitly: a Feature Entry is a human-approved boundary rule with no source, no profile and no facts digest, so it is never citable (contract §13)."
        },
        "reviewedContentDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "factsDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "sourceTreeDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "profile": {
          "type": "string",
          "pattern": "^salesforce\\.[a-z][a-z0-9-]{1,60}@[0-9]+$"
        }
      },
      "description": "SAFE-CLAIM-001 v2 grounding for intended repository-source state (docs/knowledge-one-file-contract.md par 6.2/par 8). Additive: claimRef/evidenceRef grammar untouched."
    },
    "featureRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "featureId",
        "reviewedContentDigest",
        "modelDigest",
        "claimIds"
      ],
      "properties": {
        "featureId": {
          "type": "string",
          "pattern": "^Feature:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "description": "Feature Knowledge identity `Feature:<slug>` (contract par 13). Deliberately two segments so it can never satisfy an Artifact entryRef; the two reference kinds are distinct and never interchangeable."
        },
        "reviewedContentDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "modelDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "claimIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "type": "string",
            "pattern": "^F[RC]-[0-9]{3,6}$"
          },
          "description": "Exact approved claim/relation/node ids being cited. A bare Feature reference with no claim selection is not grounding."
        }
      }
    }
  }
}
