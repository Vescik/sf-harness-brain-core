{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sf-harness-brain-core/schemas/knowledge-profile-queue.schema.json",
  "title": "Knowledge Entry profile — salesforce.queue v1",
  "description": "typeFacts carry the collector's extraction faithfully: an adapter passes every fact through except a documented exclusion, so a fact the profile does not declare fails validation loudly instead of vanishing from the entry.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "typeFacts"
  ],
  "properties": {
    "typeFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "name": {
          "type": "string"
        },
        "doesSendEmailToMembers": {
          "type": "boolean"
        },
        "memberCounts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "description": "Member counts per grantee family (users/roles/publicGroups/rolesAndSubordinates); member identities are never captured."
        },
        "servesObjects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The objects that route through this queue — its routing topology."
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "target",
              "assurance"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "pattern": "^[a-z][a-z-]{2,40}$"
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "assurance": {
                "enum": [
                  "source-exact",
                  "source-derived-heuristic"
                ]
              }
            }
          }
        }
      }
    },
    "intentionalErrors": {
      "type": "array",
      "maxItems": 0
    }
  }
}
