{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sf-harness-brain-core:solution-design-state.schema.json",
  "title": "Design Case structured state (record.json.solutionDesign)",
  "description": "Executor-managed workflow state for one Design Case. Narrative prose lives in design.md and is never duplicated here. caseVersion is an opaque computed token and is deliberately absent from this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseId",
    "status",
    "stateSequence",
    "writerAssignment",
    "nextFocus",
    "requirementSnapshot",
    "scope",
    "configurationArtefacts",
    "dataClassifications",
    "questions",
    "concernCoverage",
    "probes",
    "decisions",
    "riskObligations",
    "verificationContract",
    "applicableRules",
    "limitationRefs",
    "evidenceRefs",
    "knowledgeCandidates",
    "activeCandidateRef"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "caseId": { "$ref": "#/$defs/caseId" },
    "status": {
      "enum": [
        "draft",
        "awaiting_human_input",
        "candidate",
        "awaiting_design_review",
        "awaiting_human",
        "accepted",
        "development",
        "review",
        "complete"
      ]
    },
    "stateSequence": { "type": "integer", "minimum": 1 },
    "writerAssignment": { "$ref": "#/$defs/writerAssignment" },
    "nextFocus": {
      "enum": ["requirements", "grounding", "design", "verification", "human-input", "none"]
    },
    "requirementSnapshot": { "$ref": "#/$defs/requirementSnapshot" },
    "scope": { "$ref": "#/$defs/scope" },
    "configurationArtefacts": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/configurationArtefact" }
    },
    "dataClassifications": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/dataClassification" }
    },
    "questions": { "type": "array", "maxItems": 400, "items": { "$ref": "#/$defs/question" } },
    "concernCoverage": {
      "type": "array",
      "maxItems": 40,
      "items": { "$ref": "#/$defs/concernCoverage" }
    },
    "probes": { "type": "array", "maxItems": 400, "items": { "$ref": "#/$defs/probe" } },
    "decisions": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/decision" } },
    "riskObligations": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/riskObligation" }
    },
    "verificationContract": {
      "type": "array",
      "maxItems": 400,
      "items": { "$ref": "#/$defs/verification" }
    },
    "applicableRules": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/ruleVerdict" }
    },
    "limitationRefs": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/limitation" }
    },
    "evidenceRefs": {
      "type": "array",
      "maxItems": 400,
      "items": { "$ref": "#/$defs/evidenceRef" }
    },
    "knowledgeCandidates": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/knowledgeCandidate" }
    },
    "activeCandidateRef": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/activeCandidateRef" }]
    }
  },
  "$defs": {
    "caseId": {
      "type": "string",
      "pattern": "^(ADO-[a-z0-9][a-z0-9-]{0,62}-[1-9][0-9]*|SD-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]{0,40})$"
    },
    "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "shortText": { "type": "string", "minLength": 1, "maxLength": 400 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "refList": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "apiName": { "type": "string", "minLength": 1, "maxLength": 200 },
    "ownership": { "enum": ["package-owned", "subscriber-owned", "platform", "unknown"] },
    "authority": {
      "enum": [
        "knowledge-entry",
        "repository-receipt",
        "org-object-contract",
        "org-soql-sample",
        "human-sme-attestation",
        "vendor-documentation",
        "ado-approved-artifact",
        "production-authoritative-human"
      ]
    },
    "route": { "enum": ["requirements", "grounding", "design", "verification", "human-input"] },
    "concernProfileId": {
      "enum": [
        "data-model-and-configuration-integrity",
        "security-and-execution-context",
        "transaction-and-automation",
        "volume-and-performance",
        "integrations-and-contracts",
        "user-journey-and-accessibility",
        "errors-and-observability",
        "package-boundaries-and-upgrade",
        "migration-rollout-rollback",
        "verification-feasibility"
      ]
    },
    "writerAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["writerId", "assignedAt", "assignmentSequence", "transferReceiptRef"],
      "properties": {
        "writerId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "assignedAt": { "$ref": "#/$defs/timestamp" },
        "assignmentSequence": { "type": "integer", "minimum": 1 },
        "transferReceiptRef": {
          "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 200 }]
        }
      }
    },
    "acceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acId",
        "sourceItemId",
        "sourceLocalKey",
        "lineageKey",
        "sourceRevision",
        "summary",
        "textDigest",
        "inScope"
      ],
      "properties": {
        "acId": { "type": "string", "pattern": "^AC-[A-Za-z0-9._-]+$" },
        "sourceItemId": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }] },
        "sourceLocalKey": { "$ref": "#/$defs/shortText" },
        "lineageKey": { "$ref": "#/$defs/shortText" },
        "sourceRevision": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }] },
        "summary": { "$ref": "#/$defs/text" },
        "textDigest": { "$ref": "#/$defs/digest" },
        "inScope": { "type": "boolean" }
      }
    },
    "requirementSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceType",
        "itemId",
        "itemType",
        "revision",
        "retrievedAt",
        "sourceDigest",
        "includedItems",
        "excludedItems",
        "acceptanceCriteria",
        "completeness",
        "attestationRef",
        "unresolvedContradictions"
      ],
      "properties": {
        "sourceType": { "enum": ["ado", "human-request"] },
        "itemId": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }] },
        "itemType": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/shortText" }]
        },
        "revision": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }] },
        "retrievedAt": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/timestamp" }] },
        "sourceDigest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
        "includedItems": {
          "type": "array",
          "maxItems": 200,
          "items": { "type": "integer", "minimum": 1 }
        },
        "excludedItems": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["itemId", "reason"],
            "properties": {
              "itemId": { "type": "integer", "minimum": 1 },
              "reason": { "$ref": "#/$defs/shortText" }
            }
          }
        },
        "acceptanceCriteria": {
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "#/$defs/acceptanceCriterion" }
        },
        "completeness": { "enum": ["complete", "partial", "absent"] },
        "attestationRef": {
          "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 200 }]
        },
        "unresolvedContradictions": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/shortText" }
        }
      }
    },
    "scopeComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentId",
        "objectApiName",
        "artefactType",
        "apiName",
        "action",
        "disposition",
        "description",
        "componentOwnership",
        "hostObjectOwnership",
        "packageBoundaryRefs",
        "extensionPointStatus",
        "sourceState",
        "targetState",
        "evidenceRefs",
        "decisionRefs",
        "acIds"
      ],
      "properties": {
        "componentId": { "type": "string", "pattern": "^CMP-[A-Za-z0-9._-]+$" },
        "objectApiName": { "$ref": "#/$defs/apiName" },
        "artefactType": { "$ref": "#/$defs/apiName" },
        "apiName": { "$ref": "#/$defs/apiName" },
        "action": {
          "enum": ["use", "create", "modify", "delete", "retire", "dependency-only"]
        },
        "disposition": { "enum": ["in-scope", "dependency-only", "out-of-scope", "unknown"] },
        "dispositionReason": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/shortText" }]
        },
        "provisionalApiName": { "type": "boolean" },
        "description": { "$ref": "#/$defs/text" },
        "componentOwnership": { "$ref": "#/$defs/ownership" },
        "hostObjectOwnership": { "$ref": "#/$defs/ownership" },
        "packageBoundaryRefs": { "$ref": "#/$defs/refList" },
        "extensionPointStatus": {
          "enum": ["not-applicable", "available", "unavailable", "unknown"]
        },
        "sourceState": { "enum": ["absent", "present", "unknown"] },
        "targetState": { "enum": ["proposed", "modified", "removed", "unchanged", "unknown"] },
        "evidenceRefs": { "$ref": "#/$defs/refList" },
        "decisionRefs": { "$ref": "#/$defs/refList" },
        "acIds": { "$ref": "#/$defs/refList" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["components", "frontierComplete"],
      "properties": {
        "components": {
          "type": "array",
          "maxItems": 400,
          "items": { "$ref": "#/$defs/scopeComponent" }
        },
        "frontierComplete": { "type": "boolean" }
      }
    },
    "slice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicateTemplate", "parameters"],
      "properties": {
        "predicateTemplate": { "$ref": "#/$defs/text" },
        "parameters": {
          "type": "object",
          "maxProperties": 30,
          "additionalProperties": {
            "oneOf": [
              { "type": "string", "maxLength": 400 },
              { "type": "integer" },
              { "type": "boolean" },
              { "type": "null" }
            ]
          }
        }
      }
    },
    "dataClassification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classificationId",
        "objectApiName",
        "slice",
        "schemaOwnership",
        "dataStewardship",
        "dataRole",
        "assurance",
        "evidenceRefs",
        "limitations"
      ],
      "properties": {
        "classificationId": { "type": "string", "pattern": "^CLS-[A-Za-z0-9._-]+$" },
        "objectApiName": { "$ref": "#/$defs/apiName" },
        "slice": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/slice" }] },
        "schemaOwnership": { "$ref": "#/$defs/ownership" },
        "dataStewardship": {
          "enum": [
            "package-seeded",
            "admin-maintained",
            "user-generated",
            "system-generated",
            "mixed",
            "unknown"
          ]
        },
        "dataRole": {
          "enum": [
            "configuration",
            "reference-data",
            "transactional",
            "operational-state",
            "telemetry-audit",
            "mixed",
            "unknown"
          ]
        },
        "assurance": {
          "enum": [
            "confirmed",
            "observed-config-like",
            "observed-transactional",
            "mixed",
            "unknown"
          ]
        },
        "evidenceRefs": { "$ref": "#/$defs/refList" },
        "limitations": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/shortText" }
        }
      }
    },
    "configurationArtefact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configurationArtefactId",
        "objectApiName",
        "classificationRef",
        "naturalKeyFields",
        "action",
        "description",
        "evidenceRefs",
        "decisionRefs",
        "acIds",
        "migrationRefs",
        "rollbackRef",
        "verificationRefs"
      ],
      "properties": {
        "configurationArtefactId": { "type": "string", "pattern": "^CFG-[A-Za-z0-9._-]+$" },
        "objectApiName": { "$ref": "#/$defs/apiName" },
        "classificationRef": { "type": "string", "pattern": "^CLS-[A-Za-z0-9._-]+$" },
        "naturalKeyFields": {
          "type": "array",
          "maxItems": 30,
          "items": { "$ref": "#/$defs/apiName" }
        },
        "sliceRef": {
          "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^CLS-[A-Za-z0-9._-]+$" }]
        },
        "action": {
          "enum": [
            "create-records",
            "modify-records",
            "delete-records",
            "reuse",
            "retire",
            "dependency-only"
          ]
        },
        "description": { "$ref": "#/$defs/text" },
        "evidenceRefs": { "$ref": "#/$defs/refList" },
        "decisionRefs": { "$ref": "#/$defs/refList" },
        "acIds": { "$ref": "#/$defs/refList" },
        "migrationRefs": { "$ref": "#/$defs/refList" },
        "rollbackRef": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/shortText" }] },
        "verificationRefs": { "$ref": "#/$defs/refList" }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questionId",
        "question",
        "materiality",
        "requiredAuthority",
        "status",
        "answer",
        "evidenceRefs",
        "limitations",
        "route"
      ],
      "properties": {
        "questionId": { "type": "string", "pattern": "^Q-[A-Za-z0-9._-]+$" },
        "question": { "$ref": "#/$defs/text" },
        "materiality": { "enum": ["blocking", "advisory"] },
        "requiredAuthority": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/authority" }
        },
        "status": {
          "enum": [
            "open",
            "evidence-planned",
            "observed",
            "interpreted",
            "closed",
            "contested",
            "needs-human",
            "stale"
          ]
        },
        "answer": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/text" }] },
        "closureAuthority": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/authority" }]
        },
        "evidenceRefs": { "$ref": "#/$defs/refList" },
        "limitations": { "$ref": "#/$defs/refList" },
        "route": { "$ref": "#/$defs/route" }
      }
    },
    "concernCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concernId",
        "profileId",
        "applicability",
        "status",
        "triggerRefs",
        "treatmentRefs",
        "questionRefs",
        "riskRefs",
        "verificationRefs",
        "notApplicableReason"
      ],
      "properties": {
        "concernId": { "type": "string", "pattern": "^COV-[A-Z0-9-]+$" },
        "profileId": { "$ref": "#/$defs/concernProfileId" },
        "applicability": { "enum": ["applicable", "not-applicable"] },
        "status": { "enum": ["open", "addressed", "risk-raised"] },
        "triggerRefs": { "$ref": "#/$defs/refList" },
        "treatmentRefs": { "$ref": "#/$defs/refList" },
        "questionRefs": { "$ref": "#/$defs/refList" },
        "riskRefs": { "$ref": "#/$defs/refList" },
        "verificationRefs": { "$ref": "#/$defs/refList" },
        "notApplicableReason": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/text" }]
        }
      }
    },
    "replaySpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "canonicalTemplate", "parameters", "apiMode", "replayable"],
      "properties": {
        "kind": { "enum": ["canonical-soql", "object-contract", "manual-only"] },
        "canonicalTemplate": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/text" }] },
        "parameters": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "source"],
            "properties": {
              "name": { "$ref": "#/$defs/apiName" },
              "source": {
                "enum": ["persisted-safe-literal", "governed-resolver", "manual-entry"]
              },
              "value": {
                "oneOf": [
                  { "type": "string", "maxLength": 400 },
                  { "type": "integer" },
                  { "type": "boolean" },
                  { "type": "null" }
                ]
              },
              "resolverRef": {
                "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/shortText" }]
              }
            }
          }
        },
        "apiMode": { "enum": ["data", "tooling"] },
        "replayable": { "type": "boolean" }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probeId",
        "questionId",
        "origin",
        "kind",
        "target",
        "requiredness",
        "persistenceMode",
        "freshnessClass",
        "completenessCriterion",
        "stopCondition",
        "status",
        "receiptRef",
        "fitnessVerdict",
        "decisionImpact",
        "recheckPlan"
      ],
      "properties": {
        "probeId": { "type": "string", "pattern": "^P-[A-Za-z0-9._-]+$" },
        "questionId": { "type": "string", "pattern": "^Q-[A-Za-z0-9._-]+$" },
        "origin": { "enum": ["requirement", "question", "decision", "risk", "concern"] },
        "kind": {
          "enum": [
            "object-contract",
            "object-baseline",
            "churn-profile",
            "field-fill",
            "field-cardinality",
            "categorical-distribution",
            "key-integrity",
            "relationship-shape",
            "config-effectivity",
            "precedence-collision",
            "config-snapshot",
            "eligibility-count",
            "migration-readiness",
            "sample-shape",
            "freshness-sentinel"
          ]
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["objectApiName"],
          "properties": {
            "objectApiName": { "$ref": "#/$defs/apiName" },
            "slice": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/text" }] }
          }
        },
        "queryDigest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
        "suggestedSoql": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/text" }] },
        "replaySpec": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/replaySpec" }] },
        "expectedResultShape": {
          "enum": ["aggregate", "distribution", "shape", "snapshot", "single-value"]
        },
        "completenessCriterion": { "$ref": "#/$defs/text" },
        "requiredness": { "enum": ["hard", "conditional", "advisory"] },
        "conditionalPredicate": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/text" }]
        },
        "notApplicableReason": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/text" }]
        },
        "persistenceMode": { "enum": ["aggregate", "shape", "config-snapshot", "transient"] },
        "freshnessClass": {
          "enum": [
            "schema-observation",
            "config-observation",
            "volume-observation",
            "row-shape-observation"
          ]
        },
        "stopCondition": { "$ref": "#/$defs/text" },
        "status": {
          "enum": [
            "planned",
            "executed",
            "imported",
            "interpreted",
            "closed",
            "not-applicable",
            "blocked"
          ]
        },
        "receiptRef": {
          "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^EV-[A-Za-z0-9._-]+$" }]
        },
        "fitnessVerdict": {
          "oneOf": [
            { "type": "null" },
            { "enum": ["fit", "fit-with-constraints", "not-fit", "inconclusive"] }
          ]
        },
        "decisionImpact": {
          "oneOf": [
            { "type": "null" },
            {
              "enum": [
                "changed-scope",
                "changed-option",
                "changed-risk",
                "changed-verification",
                "confirmed-premise",
                "no-material-impact"
              ]
            }
          ]
        },
        "recheckPlan": {
          "enum": [
            "before-development",
            "before-review",
            "on-package-version-change",
            "on-schema-digest-change",
            "on-requirement-change",
            "manual-only",
            "never"
          ]
        },
        "attempts": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionId",
        "designAnchor",
        "summary",
        "rationaleSummary",
        "alternativeRefs",
        "trivialityReason",
        "status",
        "acIds",
        "componentIds",
        "questionIds",
        "evidenceRefs",
        "riskRefs",
        "verificationRefs"
      ],
      "properties": {
        "decisionId": { "type": "string", "pattern": "^D-[0-9]{3,6}$" },
        "designAnchor": { "type": "string", "pattern": "^#[A-Za-z0-9._-]+$" },
        "summary": { "$ref": "#/$defs/text" },
        "rationaleSummary": { "$ref": "#/$defs/text" },
        "alternativeRefs": { "$ref": "#/$defs/refList" },
        "trivialityReason": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/text" }] },
        "status": { "enum": ["proposed", "accepted", "superseded"] },
        "materiality": { "enum": ["material", "trivial"] },
        "acIds": { "$ref": "#/$defs/refList" },
        "componentIds": { "$ref": "#/$defs/refList" },
        "questionIds": { "$ref": "#/$defs/refList" },
        "evidenceRefs": { "$ref": "#/$defs/refList" },
        "riskRefs": { "$ref": "#/$defs/refList" },
        "verificationRefs": { "$ref": "#/$defs/refList" }
      }
    },
    "riskObligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "riskId",
        "profileId",
        "summary",
        "impact",
        "severity",
        "status",
        "triggerRefs",
        "requiredClosures",
        "mitigationDesignRef",
        "evidenceRefs",
        "acceptedRiskReceiptRef",
        "verificationRefs"
      ],
      "properties": {
        "riskId": { "type": "string", "pattern": "^R-[0-9]{3,6}$" },
        "profileId": { "$ref": "#/$defs/shortText" },
        "summary": { "$ref": "#/$defs/text" },
        "impact": { "$ref": "#/$defs/text" },
        "severity": { "enum": ["low", "medium", "high"] },
        "status": { "enum": ["open", "mitigated", "accepted", "not-applicable"] },
        "triggerRefs": { "$ref": "#/$defs/refList" },
        "requiredClosures": {
          "type": "array",
          "maxItems": 30,
          "items": { "$ref": "#/$defs/shortText" }
        },
        "satisfiedClosures": {
          "type": "array",
          "maxItems": 30,
          "items": { "$ref": "#/$defs/shortText" }
        },
        "mitigationDesignRef": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/shortText" }]
        },
        "evidenceRefs": { "$ref": "#/$defs/refList" },
        "acceptedRiskReceiptRef": {
          "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 200 }]
        },
        "verificationRefs": { "$ref": "#/$defs/refList" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verificationId",
        "acIds",
        "decisionRefs",
        "assertion",
        "method",
        "stage",
        "executorRole",
        "passCriteria",
        "expectedEvidenceType",
        "recheckProbeRefs"
      ],
      "properties": {
        "verificationId": { "type": "string", "pattern": "^V-[0-9]{3,6}$" },
        "acIds": { "$ref": "#/$defs/refList" },
        "decisionRefs": { "$ref": "#/$defs/refList" },
        "assertion": { "$ref": "#/$defs/text" },
        "method": { "$ref": "#/$defs/shortText" },
        "stage": { "enum": ["pre-development", "development", "pre-review", "post-deployment"] },
        "executorRole": {
          "enum": ["development-assistant", "test-strategist", "guardrail-reviewer", "human"]
        },
        "passCriteria": { "$ref": "#/$defs/text" },
        "expectedEvidenceType": {
          "enum": [
            "verification-execution",
            "org-observation",
            "repository-receipt",
            "human-attestation"
          ]
        },
        "recheckProbeRefs": { "$ref": "#/$defs/refList" },
        "linkedTestCaseRefs": { "$ref": "#/$defs/refList" }
      }
    },
    "ruleVerdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "tier", "severity", "verdict", "definitionDigest"],
      "properties": {
        "ruleId": { "type": "string", "pattern": "^(SAFE|MP|ORG|SF)-[A-Z0-9-]+$" },
        "tier": { "enum": ["kernel", "tier-1", "tier-2", "tier-3"] },
        "severity": { "enum": ["blocking", "advisory"] },
        "verdict": { "enum": ["honored", "tension", "violated", "not-applicable"] },
        "mitigation": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/text" }] },
        "notApplicableReason": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/text" }]
        },
        "decisionRefs": { "$ref": "#/$defs/refList" },
        "humanReceiptRef": {
          "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 200 }]
        },
        "definitionDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limitationId", "class", "summary", "affectedRefs", "impact"],
      "properties": {
        "limitationId": { "type": "string", "pattern": "^LIM-[A-Za-z0-9._-]+$" },
        "class": {
          "enum": [
            "component-limitation",
            "evidence-limitation",
            "package-limitation",
            "design-limitation",
            "operational-limitation"
          ]
        },
        "summary": { "$ref": "#/$defs/text" },
        "affectedRefs": { "$ref": "#/$defs/refList" },
        "impact": { "$ref": "#/$defs/text" },
        "mitigationRef": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/shortText" }] },
        "acceptedRiskReceiptRef": {
          "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 200 }]
        },
        "verificationRefs": { "$ref": "#/$defs/refList" },
        "sourceAuthority": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/authority" }] }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiptId",
        "path",
        "sha256",
        "sourceType",
        "assurance",
        "validationPurpose",
        "environmentFitness",
        "observedAt",
        "expiresAt",
        "completeness",
        "status",
        "questionRefs",
        "probeRefs"
      ],
      "properties": {
        "receiptId": { "type": "string", "pattern": "^EV-[A-Za-z0-9._-]+$" },
        "path": { "type": "string", "minLength": 1, "maxLength": 400 },
        "sha256": { "$ref": "#/$defs/digest" },
        "sourceType": { "$ref": "#/$defs/authority" },
        "assurance": {
          "enum": [
            "source-exact",
            "heuristic",
            "org-observed",
            "human-asserted",
            "vendor-documented"
          ]
        },
        "validationPurpose": { "enum": ["design-evidence", "transport-mechanics"] },
        "environmentFitness": {
          "enum": [
            "scope-matched-non-production",
            "non-representative-devmp",
            "not-environment-bound"
          ]
        },
        "observedAt": { "$ref": "#/$defs/timestamp" },
        "expiresAt": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/timestamp" }] },
        "completeness": { "enum": ["complete", "partial", "slice-bounded", "incomplete"] },
        "status": { "enum": ["current", "stale", "superseded", "contested"] },
        "questionRefs": { "$ref": "#/$defs/refList" },
        "probeRefs": { "$ref": "#/$defs/refList" }
      }
    },
    "knowledgeCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "reason"],
      "properties": {
        "subject": { "$ref": "#/$defs/shortText" },
        "reason": { "$ref": "#/$defs/text" }
      }
    },
    "activeCandidateRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "candidateDigest", "createdAt", "submittedFromCaseVersion", "status"],
      "properties": {
        "candidateId": { "type": "string", "pattern": "^CND-[A-Za-z0-9._-]+$" },
        "candidateDigest": { "$ref": "#/$defs/digest" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "submittedFromCaseVersion": { "type": "string", "pattern": "^cv1_[0-9a-f]{64}$" },
        "status": {
          "enum": ["candidate", "in-design-review", "awaiting-human", "accepted", "superseded"]
        }
      }
    }
  }
}
