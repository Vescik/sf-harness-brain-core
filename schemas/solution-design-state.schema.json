{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sf-harness-brain-core:solution-design-state.schema.json",
  "title": "Solution Design loop state (v2)",
  "description": "record.json.solutionDesign for the intake→discovery→plan→execute→verify→[iterate]→submit loop. Structural state only: prose lives in design.md (renderer-owned), approvals in approvals/AP-*.json, the candidate document under candidates/.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "caseId", "phase", "status", "source", "intake", "discovery",
    "planItems", "verifyRounds", "iteration", "stateSequence"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "caseId": { "type": "string", "pattern": "^(ADO-[a-z0-9][a-z0-9-]{0,62}-[1-9][0-9]*|SD-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]{0,40})$" },
    "phase": { "enum": ["intake", "discovery", "plan", "execute", "verify", "iterate"] },
    "status": { "enum": ["open", "blocked", "submitted"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "verified"],
      "properties": {
        "kind": { "enum": ["ado", "text"] },
        "itemId": { "type": ["integer", "null"] },
        "verified": { "type": "boolean" }
      }
    },
    "requirementText": { "type": "string" },
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "acceptanceCriteria", "subjects"],
      "properties": {
        "goal": { "type": ["string", "null"] },
        "acceptanceCriteria": { "type": "array" },
        "subjects": { "type": "array", "items": { "type": "string" } }
      }
    },
    "proposedSubjects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "hint"],
        "properties": { "name": { "type": "string" }, "hint": { "type": "string" } }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "result": { "type": "string" },
          "ref": { "type": ["string", "null"] },
          "ownership": { "type": ["string", "null"] },
          "namespace": { "type": ["string", "null"] },
          "schemaDigest": { "type": ["string", "null"] },
          "limitations": { "type": "array" },
          "raw": {}
        }
      }
    },
    "planItems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ungrounded"],
        "properties": {
          "id": { "type": "string" },
          "acRef": { "type": ["string", "null"] },
          "subject": { "type": ["string", "null"] },
          "action": { "type": ["string", "null"] },
          "artefactType": { "type": ["string", "null"] },
          "label": { "type": ["string", "null"] },
          "ungrounded": { "type": "boolean" }
        }
      }
    },
    "decisions": { "type": "array" },
    "verifyRounds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["round", "verdicts"],
        "properties": {
          "round": { "type": "integer" },
          "verdicts": { "type": "array" },
          "gaps": { "type": "array" }
        }
      }
    },
    "iteration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rounds", "smallestGapSetSize", "roundsWithoutShrink"],
      "properties": {
        "rounds": { "type": "integer", "minimum": 0 },
        "smallestGapSetSize": { "type": ["integer", "null"] },
        "roundsWithoutShrink": { "type": "integer", "minimum": 0 }
      }
    },
    "annotations": { "type": "array" },
    "agentDecisions": { "type": "array" },
    "prose": { "type": "object", "additionalProperties": { "type": "string" } },
    "flags": { "type": "object" },
    "execute": { "type": "object" },
    "candidate": {
      "type": ["object", "null"],
      "properties": {
        "id": { "type": "string" },
        "narrativeDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "blocked": {
      "type": ["object", "null"],
      "properties": { "unresolved": { "type": "array", "items": { "type": "string" } } }
    },
    "stateSequence": { "type": "integer", "minimum": 0 }
  }
}
