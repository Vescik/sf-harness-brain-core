{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sf-harness-brain-core:dependency-admission.schema.json",
  "title": "Third-party dependency admission record",
  "description": "One closed record per admitted non-stdlib / non-built-in runtime dependency, stored at config/dependency-admissions/<ecosystem>/<safe-slug>--<name-digest-12>.json. A dependency in use without a current matching record fails CI.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ecosystem",
    "packageName",
    "safeSlug",
    "nameDigest12",
    "version",
    "purpose",
    "rejectedAlternatives",
    "integrity",
    "provenance",
    "advisoryCheck",
    "transitiveDeltaDigest",
    "lifecycleScripts",
    "license",
    "supportedPlatforms",
    "cooldown",
    "owner",
    "reviewBy",
    "rollbackCriterion",
    "importNames"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "ecosystem": {
      "enum": [
        "python",
        "npm"
      ]
    },
    "packageName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 214
    },
    "safeSlug": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,46}[a-z0-9])?$"
    },
    "nameDigest12": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "rejectedAlternatives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alternative",
          "whyInsufficient"
        ],
        "properties": {
          "alternative": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "whyInsufficient": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lockfile",
        "mechanism"
      ],
      "properties": {
        "lockfile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "mechanism": {
          "enum": [
            "pip-hash-locked",
            "npm-lockfile-integrity"
          ]
        },
        "artifactDigests": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "string",
            "pattern": "^sha(256|512)-?:?[A-Za-z0-9+/=]{16,}$"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRepository",
        "checkedAt",
        "note"
      ],
      "properties": {
        "sourceRepository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "sourceCommit": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 80
            }
          ]
        },
        "maintainerNote": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 1000
            }
          ]
        },
        "checkedAt": {
          "type": "string",
          "format": "date-time"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "advisoryCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "checkedAt",
        "outcome"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        },
        "checkedAt": {
          "type": "string",
          "format": "date-time"
        },
        "outcome": {
          "enum": [
            "no-known-advisory",
            "advisory-accepted-with-mitigation"
          ]
        },
        "detail": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 2000
            }
          ]
        }
      }
    },
    "transitiveDeltaDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "lifecycleScripts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disabled",
        "note"
      ],
      "properties": {
        "disabled": {
          "type": "boolean"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "supportedPlatforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "enum": [
          "windows",
          "macos",
          "linux"
        ]
      }
    },
    "cooldown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applied",
        "reason"
      ],
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "reviewBy": {
      "type": "string",
      "format": "date"
    },
    "rollbackCriterion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "importNames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "description": "Module names this package makes importable. The validator maps a third-party import back to its admission record through this list."
    }
  }
}
