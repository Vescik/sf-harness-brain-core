{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sf-harness-brain-core/schemas/knowledge-profile-sharing-rules.schema.json",
  "title": "Knowledge Entry profile — salesforce.sharing-rules v1",
  "description": "typeFacts carry the collector's extraction faithfully: an adapter passes every fact through except a documented exclusion, so a fact the profile does not declare fails validation loudly instead of vanishing from the entry. shares-with edge targets are <granteeTag>:<name> strings (e.g. group:Sales_All), not component identities. The collector caps criteriaRules/ownerRules at 50 each: rulesTruncated/factsTruncated disclose the cut while the *RuleCount facts keep true totals, and referencesTruncated/truncatedFamilies disclose the edge cap.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "typeFacts"
  ],
  "properties": {
    "typeFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object"
      ],
      "properties": {
        "object": {
          "type": "string"
        },
        "criteriaRules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "accessLevel": {
                "type": "string"
              },
              "criteria": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "field": {
                      "type": "string"
                    },
                    "operator": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    },
                    "elementReference": {
                      "type": "string"
                    }
                  }
                }
              },
              "booleanFilter": {
                "type": "string"
              },
              "sharedTo": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "direction": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "description": "Criteria-based rules: which field values open records to which principals; capped at 50, true total in criteriaRuleCount."
        },
        "ownerRules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "accessLevel": {
                "type": "string"
              },
              "parties": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "direction": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "description": "Owner-based rules with both sharedFrom and sharedTo parties; capped at 50, true total in ownerRuleCount."
        },
        "criteriaRuleCount": {
          "type": "integer"
        },
        "ownerRuleCount": {
          "type": "integer"
        },
        "rulesTruncated": {
          "type": "boolean"
        },
        "factsTruncated": {
          "type": "boolean"
        },
        "referencesTruncated": {
          "type": "boolean"
        },
        "truncatedFamilies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "target",
              "assurance"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "pattern": "^[a-z][a-z-]{2,40}$"
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "assurance": {
                "enum": [
                  "source-exact",
                  "source-derived-heuristic"
                ]
              }
            }
          }
        }
      }
    },
    "intentionalErrors": {
      "type": "array",
      "maxItems": 0
    }
  }
}
