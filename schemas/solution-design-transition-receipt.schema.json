{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sf-harness-brain-core:solution-design-transition-receipt.schema.json",
  "title": "Design Case transition receipt",
  "description": "Executor-authored receipt for a durable Design Case transition. AP-* receipts live under approvals/, DR-* under reviews/, HO-* under handoffs/. Human decisions are captured from a native VS Code MCP elicitation response, never from a model-supplied field.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "receiptId", "kind", "caseId", "recordedAt", "caseVersionAtCommit", "sha256"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "receiptId": { "type": "string", "pattern": "^(AP|DR|HO)-[A-Za-z0-9._-]+$" },
    "kind": {
      "enum": [
        "candidate-approval",
        "candidate-revision-request",
        "writer-transfer",
        "design-review",
        "development-handoff"
      ]
    },
    "caseId": { "$ref": "#/$defs/caseId" },
    "recordedAt": { "$ref": "#/$defs/timestamp" },
    "caseVersionAtCommit": { "type": "string", "pattern": "^cv1_[0-9a-f]{64}$" },
    "candidateId": {
      "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^CND-[A-Za-z0-9._-]+$" }]
    },
    "candidateDigest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
    "human": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["identity", "mechanism", "elicitationNonceDigest"],
          "properties": {
            "identity": { "type": "string", "minLength": 1, "maxLength": 200 },
            "mechanism": { "const": "vscode-mcp-elicitation-v1" },
            "elicitationNonceDigest": { "$ref": "#/$defs/digest" },
            "identityAssurance": { "const": "named-user-assertion" }
          }
        }
      ]
    },
    "reason": { "oneOf": [{ "type": "null" }, { "type": "string", "maxLength": 2000 }] },
    "verdict": {
      "oneOf": [
        { "type": "null" },
        { "enum": ["PASS", "REVISE_GROUNDING", "REVISE_DESIGN", "BLOCKED_NEEDS_HUMAN"] }
      ]
    },
    "reviewerRole": {
      "oneOf": [{ "type": "null" }, { "enum": ["guardrail-reviewer"] }]
    },
    "findings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary", "route"],
        "properties": {
          "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "route": {
            "enum": ["requirements", "grounding", "design", "verification", "human-input"]
          },
          "affectedRefs": {
            "type": "array",
            "maxItems": 50,
            "items": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        }
      }
    },
    "writerTransfer": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["fromWriterId", "toWriterId", "assignmentSequence"],
          "properties": {
            "fromWriterId": { "type": "string", "minLength": 1, "maxLength": 200 },
            "toWriterId": { "type": "string", "minLength": 1, "maxLength": 200 },
            "assignmentSequence": { "type": "integer", "minimum": 2 }
          }
        }
      ]
    },
    "handoff": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["toRole", "allowedScope", "verificationContract", "recheckPlan", "requiredReads", "prohibitedActions"],
          "properties": {
            "toRole": { "enum": ["development-assistant"] },
            "allowedScope": { "type": "array", "maxItems": 400, "items": { "type": "object" } },
            "verificationContract": {
              "type": "array",
              "maxItems": 400,
              "items": { "type": "object" }
            },
            "recheckPlan": { "type": "array", "maxItems": 200, "items": { "type": "object" } },
            "risksAndLimitations": {
              "type": "array",
              "maxItems": 400,
              "items": { "type": "object" }
            },
            "repositoryBaseline": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["commit"],
                  "properties": {
                    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
                    "remote": {
                      "oneOf": [{ "type": "null" }, { "type": "string", "maxLength": 400 }]
                    }
                  }
                }
              ]
            },
            "requiredReads": {
              "type": "array",
              "maxItems": 100,
              "items": { "type": "string", "minLength": 1, "maxLength": 400 }
            },
            "prohibitedActions": {
              "type": "array",
              "maxItems": 100,
              "items": { "type": "string", "minLength": 1, "maxLength": 400 }
            }
          }
        }
      ]
    },
    "supersedes": {
      "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 200 }]
    },
    "openedObligations": {
      "type": "array",
      "maxItems": 200,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "sha256": { "$ref": "#/$defs/digest" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "candidate-approval" } }, "required": ["kind"] },
      "then": {
        "required": ["candidateId", "candidateDigest", "human"],
        "properties": {
          "candidateId": { "type": "string" },
          "candidateDigest": { "$ref": "#/$defs/digest" },
          "human": { "type": "object" }
        }
      }
    },
    {
      "if": {
        "properties": { "kind": { "const": "candidate-revision-request" } },
        "required": ["kind"]
      },
      "then": {
        "required": ["candidateId", "candidateDigest", "human", "reason"],
        "properties": {
          "candidateId": { "type": "string" },
          "candidateDigest": { "$ref": "#/$defs/digest" },
          "human": { "type": "object" },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "writer-transfer" } }, "required": ["kind"] },
      "then": {
        "required": ["human", "writerTransfer"],
        "properties": { "human": { "type": "object" }, "writerTransfer": { "type": "object" } }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "design-review" } }, "required": ["kind"] },
      "then": {
        "required": ["candidateId", "candidateDigest", "verdict", "reviewerRole"],
        "properties": {
          "candidateId": { "type": "string" },
          "candidateDigest": { "$ref": "#/$defs/digest" },
          "verdict": { "type": "string" },
          "reviewerRole": { "type": "string" }
        }
      }
    },
    {
      "if": {
        "properties": { "kind": { "const": "development-handoff" } },
        "required": ["kind"]
      },
      "then": {
        "required": ["candidateId", "candidateDigest", "handoff"],
        "properties": {
          "candidateId": { "type": "string" },
          "candidateDigest": { "$ref": "#/$defs/digest" },
          "handoff": { "type": "object" }
        }
      }
    }
  ],
  "$defs": {
    "caseId": {
      "type": "string",
      "pattern": "^(ADO-[a-z0-9][a-z0-9-]{0,62}-[1-9][0-9]*|SD-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]{0,40})$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
