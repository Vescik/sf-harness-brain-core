{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sf-harness-brain-core/schemas/knowledge-profile-aura.schema.json",
  "title": "Knowledge Entry profile — salesforce.aura v1",
  "description": "typeFacts carry the collector's extraction faithfully: an adapter passes every fact through except a documented exclusion, so a fact the profile does not declare fails validation loudly instead of vanishing from the entry. Every markup-derived edge is a regex read over bundle source and carries the heuristic marker.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "typeFacts"
  ],
  "properties": {
    "typeFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definitionTypes"
      ],
      "properties": {
        "definitionTypes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "File suffixes present in the bundle (cmp, app, evt, js, css, design, ...) — the bundle's surface at a glance."
        },
        "implements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extends": {
          "type": "string"
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "target",
              "assurance"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "pattern": "^[a-z][a-z-]{2,40}$"
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "assurance": {
                "enum": [
                  "source-exact",
                  "source-derived-heuristic"
                ]
              }
            }
          }
        }
      }
    },
    "intentionalErrors": {
      "type": "array",
      "maxItems": 0
    }
  }
}
