{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sf-harness-brain-core/schemas/knowledge-profile-dashboard.schema.json",
  "title": "Knowledge Entry profile — salesforce.dashboard v1",
  "description": "typeFacts carry the collector's extraction faithfully: an adapter passes every fact through except a documented exclusion, so a fact the profile does not declare fails validation loudly instead of vanishing from the entry. Component identity is folder-qualified (Folder/Name); the folder fact is absent for a dashboard sitting directly under dashboards/. runningUserPolicy records the run-as mode only — never a username.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "typeFacts"
  ],
  "properties": {
    "typeFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "folder": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "runningUserPolicy": {
          "type": "string"
        },
        "componentCount": {
          "type": "integer"
        },
        "reports": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Folder-qualified report names the dashboard reads — also emitted as displays-component edges."
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "target",
              "assurance"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "pattern": "^[a-z][a-z-]{2,40}$"
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "assurance": {
                "enum": [
                  "source-exact",
                  "source-derived-heuristic"
                ]
              }
            }
          }
        }
      }
    },
    "intentionalErrors": {
      "type": "array",
      "maxItems": 0
    }
  }
}
