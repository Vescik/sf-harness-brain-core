{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sf-harness-brain-core:solution-design-candidate.schema.json",
  "title": "Immutable Design Case candidate bundle",
  "description": "Written once by design_submit to .ai/change-records/<case-id>/candidates/<candidate-id>/bundle.json. Every semantically approved field lives inside candidateDigestInput; only createdAt, candidateDigest itself and later approval metadata are outside it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "candidateId", "caseId", "createdAt", "candidateDigest", "candidateDigestInput"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "candidateId": { "type": "string", "pattern": "^CND-[A-Za-z0-9._-]+$" },
    "caseId": { "$ref": "#/$defs/caseId" },
    "createdAt": { "$ref": "#/$defs/timestamp" },
    "candidateDigest": { "$ref": "#/$defs/digest" },
    "candidateDigestInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundleSchemaVersion",
        "gateEvaluatorVersion",
        "capabilityManifestDigest",
        "caseId",
        "candidateId",
        "submittedFromCaseVersion",
        "requirementSnapshot",
        "designDigest",
        "structuredStateSnapshot",
        "evidenceManifest",
        "applicablePolicySnapshot",
        "verificationContract",
        "sourceRefs",
        "orgPackageFingerprints",
        "gateReport",
        "riskClassification",
        "authorWriterAssignment",
        "concernCoverage",
        "knownLimitations",
        "acceptedRiskReceiptRefs",
        "recheckPlan"
      ],
      "properties": {
        "bundleSchemaVersion": { "const": 1 },
        "gateEvaluatorVersion": { "type": "string", "minLength": 1, "maxLength": 40 },
        "capabilityManifestDigest": { "$ref": "#/$defs/digest" },
        "caseId": { "$ref": "#/$defs/caseId" },
        "candidateId": { "type": "string", "pattern": "^CND-[A-Za-z0-9._-]+$" },
        "submittedFromCaseVersion": { "type": "string", "pattern": "^cv1_[0-9a-f]{64}$" },
        "requirementSnapshot": { "type": "object" },
        "designDigest": { "$ref": "#/$defs/digest" },
        "structuredStateSnapshot": { "type": "object" },
        "evidenceManifest": {
          "type": "array",
          "maxItems": 400,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["receiptId", "sha256", "sourceType", "completeness", "observedAt"],
            "properties": {
              "receiptId": { "type": "string", "pattern": "^EV-[A-Za-z0-9._-]+$" },
              "sha256": { "$ref": "#/$defs/digest" },
              "sourceType": { "type": "string", "minLength": 1, "maxLength": 80 },
              "completeness": { "type": "string", "minLength": 1, "maxLength": 40 },
              "observedAt": { "$ref": "#/$defs/timestamp" },
              "expiresAt": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/timestamp" }] }
            }
          }
        },
        "applicablePolicySnapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicablePolicyDigest", "rules", "sourceAuthorityPolicyVersion"],
          "properties": {
            "applicablePolicyDigest": { "$ref": "#/$defs/digest" },
            "rules": {
              "type": "array",
              "maxItems": 200,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["ruleId", "severity", "verdict", "definitionDigest"],
                "properties": {
                  "ruleId": { "type": "string", "pattern": "^(SAFE|MP|ORG|SF)-[A-Z0-9-]+$" },
                  "severity": { "enum": ["blocking", "advisory"] },
                  "verdict": { "enum": ["honored", "tension", "violated", "not-applicable"] },
                  "definitionDigest": { "$ref": "#/$defs/digest" }
                }
              }
            },
            "limitationDigests": {
              "type": "array",
              "maxItems": 200,
              "items": { "$ref": "#/$defs/digest" }
            },
            "riskProfileDigests": {
              "type": "array",
              "maxItems": 200,
              "items": { "$ref": "#/$defs/digest" }
            },
            "sourceAuthorityPolicyVersion": { "type": "string", "minLength": 1, "maxLength": 40 }
          }
        },
        "verificationContract": { "type": "array", "maxItems": 400, "items": { "type": "object" } },
        "sourceRefs": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "identity", "contentDigest"],
            "properties": {
              "kind": { "type": "string", "minLength": 1, "maxLength": 80 },
              "identity": { "type": "string", "minLength": 1, "maxLength": 1000 },
              "revision": {
                "oneOf": [
                  { "type": "null" },
                  { "type": "string", "maxLength": 200 },
                  { "type": "integer", "minimum": 0 }
                ]
              },
              "contentDigest": { "$ref": "#/$defs/digest" }
            }
          }
        },
        "orgPackageFingerprints": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["orgIdDigest", "packageNamespace", "packageVersion"],
            "properties": {
              "orgIdDigest": { "$ref": "#/$defs/digest" },
              "packageNamespace": {
                "oneOf": [{ "type": "null" }, { "type": "string", "maxLength": 80 }]
              },
              "packageVersion": {
                "oneOf": [{ "type": "null" }, { "type": "string", "maxLength": 80 }]
              }
            }
          }
        },
        "gateReport": { "type": "object" },
        "riskClassification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tier", "triggers"],
          "properties": {
            "tier": { "enum": ["standard", "high"] },
            "triggers": {
              "type": "array",
              "maxItems": 50,
              "items": { "type": "string", "minLength": 1, "maxLength": 200 }
            }
          }
        },
        "authorWriterAssignment": { "type": "object" },
        "concernCoverage": { "type": "array", "maxItems": 40, "items": { "type": "object" } },
        "knownLimitations": { "type": "array", "maxItems": 200, "items": { "type": "object" } },
        "acceptedRiskReceiptRefs": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "recheckPlan": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["probeId", "trigger", "replayable"],
            "properties": {
              "probeId": { "type": "string", "pattern": "^P-[A-Za-z0-9._-]+$" },
              "trigger": {
                "enum": [
                  "before-development",
                  "before-review",
                  "on-package-version-change",
                  "on-schema-digest-change",
                  "on-requirement-change",
                  "manual-only",
                  "never"
                ]
              },
              "replayable": { "type": "boolean" }
            }
          }
        }
      }
    },
    "supersededAt": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/timestamp" }] },
    "supersededReason": {
      "oneOf": [{ "type": "null" }, { "type": "string", "maxLength": 1000 }]
    }
  },
  "$defs": {
    "caseId": {
      "type": "string",
      "pattern": "^(ADO-[a-z0-9][a-z0-9-]{0,62}-[1-9][0-9]*|SD-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]{0,40})$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
