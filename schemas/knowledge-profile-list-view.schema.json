{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sf-harness-brain-core/schemas/knowledge-profile-list-view.schema.json",
  "title": "Knowledge Entry profile — salesforce.list-view v1",
  "description": "typeFacts carry the collector's extraction faithfully: an adapter passes every fact through except a documented exclusion, so a fact the profile does not declare fails validation loudly instead of vanishing from the entry. The collector caps the inlined columns array at 50: columnsTruncated/factsTruncated disclose the cut while columnCount keeps the true total.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "typeFacts"
  ],
  "properties": {
    "typeFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object"
      ],
      "properties": {
        "object": {
          "type": "string"
        },
        "fullName": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "filterScope": {
          "type": "string"
        },
        "queue": {
          "type": "string",
          "description": "Owning queue of a Queue-scoped view — the working set that queue's members actually drain."
        },
        "booleanFilter": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Rendered columns in document order, capped at 50 by the collector; columnCount keeps the true total."
        },
        "columnCount": {
          "type": "integer"
        },
        "columnsTruncated": {
          "type": "boolean"
        },
        "factsTruncated": {
          "type": "boolean"
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "field": {
                "type": "string"
              },
              "operator": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "elementReference": {
                "type": "string"
              }
            }
          },
          "description": "Declared filter criteria; literals pass sanitize_literal (no credentials, emails, IPs, URL paths)."
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "target",
              "assurance"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "pattern": "^[a-z][a-z-]{2,40}$"
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "assurance": {
                "enum": [
                  "source-exact",
                  "source-derived-heuristic"
                ]
              }
            }
          }
        }
      }
    },
    "intentionalErrors": {
      "type": "array",
      "maxItems": 0
    }
  }
}
