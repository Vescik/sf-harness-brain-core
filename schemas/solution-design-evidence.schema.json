{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sf-harness-brain-core:solution-design-evidence.schema.json",
  "title": "Design Case evidence receipt",
  "description": "Executor-authored, immutable evidence receipt stored at .ai/change-records/<case-id>/evidence/EV-<id>.json. The model never authors one. Raw external rows never appear here outside the governed config-snapshot persistence mode.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptId",
    "caseId",
    "questionId",
    "probeId",
    "sourceType",
    "assurance",
    "validationPurpose",
    "environmentFitness",
    "observedAt",
    "expiresAt",
    "result",
    "transform",
    "sensitivityClass",
    "limitations",
    "sha256"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "receiptId": { "type": "string", "pattern": "^EV-[A-Za-z0-9._-]+$" },
    "caseId": {
      "type": "string",
      "pattern": "^(ADO-[a-z0-9][a-z0-9-]{0,62}-[1-9][0-9]*|SD-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]{0,40})$"
    },
    "questionId": {
      "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^Q-[A-Za-z0-9._-]+$" }]
    },
    "probeId": {
      "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^P-[A-Za-z0-9._-]+$" }]
    },
    "sourceType": {
      "enum": [
        "knowledge-entry",
        "repository-receipt",
        "org-object-contract",
        "org-soql-sample",
        "human-sme-attestation",
        "vendor-documentation",
        "ado-approved-artifact",
        "production-authoritative-human"
      ]
    },
    "assurance": {
      "enum": ["source-exact", "heuristic", "org-observed", "human-asserted", "vendor-documented"]
    },
    "validationPurpose": { "enum": ["design-evidence", "transport-mechanics"] },
    "environmentFitness": {
      "enum": [
        "scope-matched-non-production",
        "non-representative-devmp",
        "not-environment-bound"
      ]
    },
    "org": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["environment", "orgIdDigest", "fullCopy"],
          "properties": {
            "environment": { "enum": ["development", "sandbox", "scratch"] },
            "orgIdDigest": { "$ref": "#/$defs/digest" },
            "fullCopy": { "type": "boolean" }
          }
        }
      ]
    },
    "package": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["namespace", "version"],
          "properties": {
            "namespace": { "oneOf": [{ "type": "null" }, { "type": "string", "maxLength": 80 }] },
            "version": { "oneOf": [{ "type": "null" }, { "type": "string", "maxLength": 80 }] }
          }
        }
      ]
    },
    "query": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["queryDigest", "fromObjects", "replaySpec", "replaySpecDigest"],
          "properties": {
            "queryDigest": { "$ref": "#/$defs/digest" },
            "fromObjects": {
              "type": "array",
              "maxItems": 20,
              "items": { "type": "string", "minLength": 1, "maxLength": 200 }
            },
            "replaySpec": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "canonicalTemplate", "parameters", "apiMode", "replayable"],
              "properties": {
                "kind": { "enum": ["canonical-soql", "object-contract", "manual-only"] },
                "canonicalTemplate": {
                  "oneOf": [{ "type": "null" }, { "type": "string", "maxLength": 4000 }]
                },
                "parameters": {
                  "type": "array",
                  "maxItems": 30,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name", "source"],
                    "properties": {
                      "name": { "type": "string", "minLength": 1, "maxLength": 200 },
                      "source": {
                        "enum": ["persisted-safe-literal", "governed-resolver", "manual-entry"]
                      },
                      "value": {
                        "oneOf": [
                          { "type": "string", "maxLength": 400 },
                          { "type": "integer" },
                          { "type": "boolean" },
                          { "type": "null" }
                        ]
                      },
                      "resolverRef": {
                        "oneOf": [{ "type": "null" }, { "type": "string", "maxLength": 400 }]
                      }
                    }
                  }
                },
                "apiMode": { "enum": ["data", "tooling"] },
                "replayable": { "type": "boolean" }
              }
            },
            "replaySpecDigest": { "$ref": "#/$defs/digest" }
          }
        }
      ]
    },
    "source": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "identity", "revision", "contentDigest", "coverage"],
          "properties": {
            "kind": { "enum": ["knowledge-entry", "git-blob", "ado-item", "vendor-document"] },
            "identity": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "revision": {
              "oneOf": [
                { "type": "null" },
                { "type": "string", "maxLength": 200 },
                { "type": "integer", "minimum": 0 }
              ]
            },
            "path": { "oneOf": [{ "type": "null" }, { "type": "string", "maxLength": 1000 }] },
            "blobOid": {
              "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{40,64}$" }]
            },
            "range": { "oneOf": [{ "type": "null" }, { "type": "string", "maxLength": 200 }] },
            "contentDigest": { "$ref": "#/$defs/digest" },
            "coverage": { "enum": ["full", "partial", "range-bounded"] },
            "workingTreeDrift": { "type": "boolean" }
          }
        }
      ]
    },
    "human": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["identity", "authorityRole", "mechanism", "effectiveAt"],
          "properties": {
            "identity": { "type": "string", "minLength": 1, "maxLength": 200 },
            "authorityRole": {
              "enum": [
                "requirement-owner",
                "subject-matter-expert",
                "package-vendor",
                "production-owner",
                "risk-owner"
              ]
            },
            "mechanism": { "const": "vscode-mcp-elicitation-v1" },
            "applicabilityScope": {
              "oneOf": [{ "type": "null" }, { "type": "string", "maxLength": 1000 }]
            },
            "effectiveAt": { "$ref": "#/$defs/timestamp" }
          }
        }
      ]
    },
    "observedAt": { "$ref": "#/$defs/timestamp" },
    "expiresAt": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/timestamp" }] },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "completeness", "derivedFacts"],
      "properties": {
        "kind": { "type": "string", "minLength": 1, "maxLength": 80 },
        "completeness": { "enum": ["complete", "partial", "slice-bounded", "incomplete"] },
        "derivedFacts": { "type": "object" }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "policyDigest"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "policyDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "rawResultDigest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
    "sensitivityClass": {
      "enum": ["internal-sanitized", "internal-config-snapshot", "non-sensitive"]
    },
    "limitations": {
      "type": "array",
      "maxItems": 50,
      "items": { "type": "string", "minLength": 1, "maxLength": 400 }
    },
    "sha256": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
