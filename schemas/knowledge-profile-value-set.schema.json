{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sf-harness-brain-core/schemas/knowledge-profile-value-set.schema.json",
  "title": "Knowledge Entry profile — salesforce.value-set v1 (GlobalValueSet, StandardValueSet)",
  "description": "typeFacts carry the collector's extraction faithfully: an adapter passes every fact through except a documented exclusion, so a fact the profile does not declare fails validation loudly instead of vanishing from the entry.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "typeFacts"
  ],
  "properties": {
    "typeFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "masterLabel": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "sorted": {
          "type": "boolean"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "fullName": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "default": {
                "type": "boolean"
              },
              "isActive": {
                "type": "boolean"
              },
              "closed": {
                "type": "boolean"
              },
              "won": {
                "type": "boolean"
              },
              "converted": {
                "type": "boolean"
              },
              "probability": {
                "type": "string",
                "description": "Kept as the source string — nested fact values are never integer-normalized, only top-level ones are."
              },
              "forecastCategory": {
                "type": "string"
              }
            }
          },
          "description": "Per-value lifecycle semantics (closed/won/converted/probability on standard sets) — answers what counts as a won deal here from source. Capped; valueCount holds the true total."
        },
        "valueCount": {
          "type": "integer",
          "description": "True total number of values before the cap."
        },
        "valuesTruncated": {
          "type": "boolean",
          "description": "Present (true) only when values[] was capped below valueCount."
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "target",
              "assurance"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "pattern": "^[a-z][a-z-]{2,40}$"
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "assurance": {
                "enum": [
                  "source-exact",
                  "source-derived-heuristic"
                ]
              }
            }
          }
        }
      }
    },
    "intentionalErrors": {
      "type": "array",
      "maxItems": 0
    }
  }
}
