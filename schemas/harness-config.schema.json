{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sf-harness-brain-core:harness-config.schema.json",
  "title": "Brain-core local configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ado",
    "salesforce",
    "safety",
    "workspace",
    "cache"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chatReviewer"
      ],
      "properties": {
        "chatReviewer": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ado": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organization",
        "project",
        "releaseQueryId",
        "allowedHttpsOrigins"
      ],
      "properties": {
        "organization": {
          "type": "string",
          "minLength": 1
        },
        "project": {
          "type": "string",
          "minLength": 1
        },
        "releaseQueryId": {
          "type": "string",
          "minLength": 1
        },
        "allowedHttpsOrigins": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    },
    "salesforce": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orgs",
        "review"
      ],
      "properties": {
        "orgs": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "alias",
              "environment"
            ],
            "properties": {
              "alias": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
              },
              "environment": {
                "description": "production is a deny marker: the alias is refused everywhere (owner decisions 2026-07-31 and 2026-08-04).",
                "enum": [
                  "development",
                  "qa",
                  "uat",
                  "production"
                ]
              },
              "allowAgentRead": {
                "description": "Retired 2026-08-04 (read-anywhere convention); tolerated in existing configs, read by nothing.",
                "type": "boolean"
              },
              "allowAgentWrite": {
                "description": "Retired 2026-08-04 with the development/write lane; tolerated in existing configs, read by nothing.",
                "type": "boolean"
              },
              "allowAgentReview": {
                "description": "Retired 2026-08-04 (read-anywhere convention); tolerated in existing configs, read by nothing.",
                "type": "boolean"
              },
              "expectedInstanceHost": {
                "type": "string",
                "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9-]*--[A-Za-z0-9][A-Za-z0-9-]*\\.sandbox\\.my\\.salesforce\\.com|[A-Za-z0-9][A-Za-z0-9-]*\\.scratch\\.my\\.salesforce\\.com|[A-Za-z0-9][A-Za-z0-9-]*\\.develop\\.my\\.salesforce\\.com)$"
              },
              "expectedOrganizationId": {
                "type": "string",
                "pattern": "^00D[A-Za-z0-9]{12}(?:[A-Za-z0-9]{3})?$"
              },
              "fullCopy": {
                "type": "boolean",
                "description": "Gate-4 owner fact (org-usage layer): true = full-copy sandbox, false = partial/developer. Labels orgUsage blocks so consumers can weigh representativeness; absent = unknown. Sandbox numbers answer shape/presence, never production volume."
              },
              "refreshedAt": {
                "type": "string",
                "format": "date-time",
                "description": "Owner-set instant of the last sandbox refresh for this alias. Fallback refresh detector for the org-usage layer: orgUsage blocks observed before this instant are org-superseded even when the Organization Id survived the refresh (orgIdDigest alone cannot detect that case)."
              }
            },
            "allOf": [
              {
                "description": "Identity pins are optional (owner 2026-08-04) but travel together: both present keeps the strict exact-org lane, both absent is the discovery lane, exactly one is a config error.",
                "if": {
                  "required": [
                    "expectedInstanceHost"
                  ]
                },
                "then": {
                  "required": [
                    "expectedOrganizationId"
                  ]
                }
              },
              {
                "if": {
                  "required": [
                    "expectedOrganizationId"
                  ]
                },
                "then": {
                  "required": [
                    "expectedInstanceHost"
                  ]
                }
              }
            ]
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "apiVersion",
            "requireDualSource",
            "allowedPackageNamespaces",
            "maxFieldsPerObject",
            "evidenceMaxAgeMinutes"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "allowAnyNonProduction": {
              "description": "Retired 2026-08-04: any alias proving a non-production identity is admitted unconditionally; tolerated in existing configs, read by nothing. deniedOrganizationIds is the remaining org-level brake.",
              "type": "boolean"
            },
            "deniedOrganizationIds": {
              "description": "Owner decision 2026-08-04: organization IDs (00D…, 15 or 18 characters) that agents must never read, whatever alias resolves to them. Enforced at live identity proof time in the review facade (both transport legs) and by verify_salesforce_org.py. The org-level complement of the developer's-responsibility read-anywhere convention.",
              "type": "array",
              "maxItems": 50,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^00D[A-Za-z0-9]{12}(?:[A-Za-z0-9]{3})?$"
              }
            },
            "apiVersion": {
              "type": "string",
              "pattern": "^[0-9]{2}\\.0$"
            },
            "requireDualSource": {
              "const": true
            },
            "allowedPackageNamespaces": {
              "description": "Namespaces of managed packages in review scope. An empty list means NO managed packages (correct for an org that has none — a Developer Edition or a clean sandbox); [\"*\"] means every installed package. An explicit list stays the tightest option and is preferred where the set is known.",
              "type": "array",
              "maxItems": 20,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^(\\*|[A-Za-z][A-Za-z0-9]{0,14})$"
              }
            },
            "allowedObjectApiNames": {
              "description": "Optional since the 2026-07-30 owner decision: an absent key means all objects (equivalent to [\"*\"]). An explicit list remains fully supported for orgs holding sensitive data.",
              "type": "array",
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^(\\*|[A-Za-z][A-Za-z0-9_]{0,79})$"
              }
            },
            "maxObjectsPerCall": {
              "description": "Retired 2026-08-04 with scripts/salesforce_read.py; tolerated in existing configs, read by nothing.",
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "maxFieldsPerObject": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "evidenceMaxAgeMinutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              "then": {
                "properties": {
                  "allowedObjectApiNames": {
                    "minItems": 1
                  }
                }
              },
              "else": {
                "properties": {
                  "allowedPackageNamespaces": {
                    "maxItems": 0
                  },
                  "allowedObjectApiNames": {
                    "maxItems": 0
                  }
                }
              }
            }
          ]
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sharedSandboxWritesApproved",
        "sharedSandboxApprovalRef"
      ],
      "properties": {
        "sharedSandboxWritesApproved": {
          "type": "boolean"
        },
        "sharedSandboxApprovalRef": {
          "type": "string"
        },
        "browserSessionApproval": {
          "description": "One human confirmation covers further state-changing browser actions in the same guarded session on the same origin (receipt-bounded, TTL). Default off.",
          "type": "boolean"
        },
        "autoApproveRetrieveWithReceipt": {
          "description": "Skip the per-invocation confirmation for `sf project retrieve start` against a read-allowed sandbox while a fresh metadata preflight PASS receipt exists and force-app is clean. Default off.",
          "type": "boolean"
        },
        "allowScopedEnumeration": {
          "description": "Expose the review_configured_orgs facade listing ONLY the orgs configured in this file. Foreign enumeration tools stay denied. Default off.",
          "type": "boolean"
        },
        "batchDevToolApproval": {
          "description": "Retired 2026-08-04 with the dev-tool batch pipeline; tolerated in existing configs, read by nothing — every dev-tool call asks per invocation.",
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "sharedSandboxWritesApproved": {
                "const": true
              }
            },
            "required": [
              "sharedSandboxWritesApproved"
            ]
          },
          "then": {
            "properties": {
              "sharedSandboxApprovalRef": {
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedOrigins",
        "profileDirectory"
      ],
      "properties": {
        "allowedOrigins": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^https://(?:[A-Za-z0-9-]+--[A-Za-z0-9-]+\\.sandbox\\.(?:my\\.salesforce\\.com|lightning\\.force\\.com|my\\.site\\.com)|[A-Za-z0-9][A-Za-z0-9-]*\\.scratch\\.my\\.salesforce\\.com)/?$"
          }
        },
        "profileDirectory": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "salesforceRootName",
        "manifestPath"
      ],
      "properties": {
        "salesforceRootName": {
          "const": "brain-core"
        },
        "manifestPath": {
          "type": "string",
          "minLength": 1
        },
        "promotedTestsPath": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adoItemMaxAgeMinutes",
        "testCaseMaxAgeMinutes",
        "onStaleDefault"
      ],
      "properties": {
        "adoItemMaxAgeMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "testCaseMaxAgeMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "wikiPageMaxAgeMinutes": {
          "description": "Freshness window for cached wiki pages under .cache/ado-wiki/ (owner-set; onStaleDefault governs behavior past it).",
          "type": "integer",
          "minimum": 1
        },
        "onStaleDefault": {
          "enum": [
            "ask",
            "refresh",
            "use",
            "fail"
          ]
        }
      }
    }
  }
}
